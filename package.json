{
  "name": "claude-config-distributor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "dist": "electron-builder -c"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "fs-extra": "^11.2.0",
    "lodash.merge": "^4.6.2",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^32.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0",
    "electron-builder": "^24.9.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0"
  }
}
