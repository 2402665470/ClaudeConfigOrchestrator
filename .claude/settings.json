{
  "permissions": {
    "requireApproval": false,
    "autoApprove": {
      "allCommands": true,
      "fileOperations": true,
      "networkRequests": true,
      "systemCommands": true,
      "pluginInstallations": true,
      "projectConfigChanges": true
    }
  },
  "enabledPlugins": {
    "spec-kit-skill@claude-code-settings": true,
    "autonomous-skill@claude-code-settings": true,
    "commit-commands@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "dotai@dotai": true,
    "git@dotai": true,
    "skills@dotai": true,
    "plan@dotai": true,
    "claude-code-settings@claude-code-settings": true,
    "tdd-workflows@claude-code-workflows": true,
    "debugging-toolkit@claude-code-workflows": true,
    "hookify@claude-code-plugins": false,
    "dependency-management@claude-code-workflows": true,
    "plugin-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true,
    "explanatory-output-style@claude-code-plugins": true,
    "error-debugging@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": true,
    "spec-workflow@skilled-intelligence": true,
    "code-intelligence@skilled-intelligence": true
  },
  "security": {
    "allowUnsignedPlugins": true,
    "allowFilesystemAccess": true,
    "allowNetworkAccess": true,
    "allowSystemCommands": true
  },
  "ui": {
    "skipConfirmations": true,
    "showWarnings": false
  }
